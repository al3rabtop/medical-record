# MySQL connection string
DATABASE_URL=mysql://user:password@localhost:3306/mom_medical_record

# JWT signing secret (generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))")
JWT_SECRET=

# Login credentials (single-owner app)
AUTH_EMAIL=you@example.com
AUTH_PASSWORD_HASH=

# Optional, marks this user as owner in DB (defaults fine as-is)
OWNER_OPEN_ID=

PORT=3000

# Object storage for compressed original report copies (S3-compatible: AWS S3 or Cloudflare R2)
# For Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com
# For AWS S3: leave empty
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
# R2 has no regions and expects "auto"; set a real region (e.g. us-east-1) for AWS S3
S3_REGION=auto
