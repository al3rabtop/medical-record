# MySQL connection string
DATABASE_URL=mysql://user:password@localhost:3306/mom_medical_record

# JWT signing secret (generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))")
JWT_SECRET=

# Login credentials (single-owner app)
AUTH_EMAIL=you@example.com
AUTH_PASSWORD_HASH=

# Optional, marks this user as owner in DB (defaults fine as-is)
OWNER_OPEN_ID=

PORT=3000
